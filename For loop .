#include <stdio.h>

int main()
{
    int i, attendance, present = 0;

    for(i = 1; i <= 30; i++)
    {
        printf("Student %d : ", i);
        scanf("%d", &attendance);

        if(attendance == 1)
        {
            present++;
        }
    }

    printf("Total Present Students = %d", present);

    return 0;
}
